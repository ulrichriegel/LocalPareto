h <- function(x) {
return(dnorm(x) / (1 - pnorm(x)))
}
ggplot() + xlim(c(0,6)) +
stat_function(fun = function(x) h(x), size = 1.5) +
stat_function(fun = function(x) x, size = 1.5, linetype = "dashed") +
