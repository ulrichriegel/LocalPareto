library(Pareto)
library(LocalPareto)
alpha_0 <- 1.5
t <- 1000
gamma <- 0.5
alpha <- function(x) alpha_0 + alpha_0 * gamma * log(x/t)
alpha_t <- function(x) {
if (x>t) {
alpha_0 + alpha_0 * gamma * log(x/t)
} else {
0
}
}
alpha_t2 <- function(x) {
return(ifelse(x>t, alpha_0 + alpha_0 * gamma * log(x/t), 0))
}
PP_Parameters <- LocalPareto_2_PiecewisePareto(alpha, t)
