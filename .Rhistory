pLocalPareto(x=(1:10)*2000, alpha, t)
#pLocalPareto(x=(1:10)*2000, alpha_t)
pLocalPareto(x=(1:10)*2000, alpha_t2)
dLALocPareto(x=(0:10)*2000, t, alpha_0, gamma)
dPiecewisePareto(x=(0:10)*2000, t=PP_Parameters$t, alpha=PP_Parameters$alpha)
dLocalPareto(x=(0:10)*2000, alpha, t)
