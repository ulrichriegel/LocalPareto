t <- 1000
alpha <- function(x) ifelse(x >= t,
1 / 2 + x / 50000 + 1 / 2 * sin(4 * (x - t) / t) * exp(-0.2 * (x - 1000) / 1000),
0)
ggplot(data = data.frame(x = c(1, 20000)), aes(x = x)) +
stat_function(data = data.frame(x = c(1000, 20000)), fun = function(x) alpha(x), size = 1.5, n=1000, color = "gray") +
stat_function(fun = function(x) pLocalPareto(x, alpha), size = 1.5)
