} else {
return("SF must be decreasing.")
}
}
if (alpha[k] <= 0) {
if (!comment) {
return(FALSE)
} else {
return("Last alpha must be positive.")
}
}
if (!comment) {
return(TRUE)
} else {
return("OK")
}
}
valid.parameters.PiecewisePareto(PP_Parameters)
