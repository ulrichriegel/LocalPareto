t <- 1000
alpha_ini <- 1
alpha_tail <- 2
alpha <- function(x, tau) {
ifelse(x < t, 0, alpha_tail * ((tau * (x - t) + t) / t) / (alpha_tail / alpha_ini + (tau * (x - t) + t) / t - 1))
}
alpha16 <- function(x) alpha(x, 16)
alpha8 <- function(x) alpha(x, 8)
alpha4 <- function(x) alpha(x, 4)
alpha2 <- function(x) alpha(x, 2)
alpha1 <- function(x) alpha(x, 1)
alpha.5 <- function(x) alpha(x, .5)
alpha.25 <- function(x) alpha(x, .25)
alpha.1 <- function(x) alpha(x, .1)
alpha.025 <- function(x) alpha(x, .025)
ggplot(data = data.frame(x = c(1000, 20000)), aes(x = x)) +
stat_function(fun = function(x) alpha16(x), linewidth = 1, linetype = "longdash", n=10000) +
stat_function(fun = function(x) alpha8(x), linewidth = 1, linetype = "longdash", n=10000) +
stat_function(fun = function(x) alpha4(x), linewidth = 1, linetype = "longdash", n=10000) +
stat_function(fun = function(x) alpha2(x), linewidth = 1, linetype = "longdash", n=10000) +
stat_function(fun = function(x) alpha1(x), linewidth = 1, n=10000, color = "gray") +
stat_function(fun = function(x) alpha.5(x), linewidth = 1, linetype = "solid", n=10000) +
stat_function(fun = function(x) alpha.25(x), linewidth = 1, linetype = "solid", n=10000) +
stat_function(fun = function(x) alpha.1(x), linewidth = 1, linetype = "solid", n=10000) +
stat_function(fun = function(x) alpha.025(x), linewidth = 1, linetype = "solid", n=10000) +
