t <- 1000
alpha_ini <- 1
alpha_tail <- 2
alpha <- function(x, tau) {
ifelse(x < t, 0, alpha_tail * ((tau * (x - t) + t) / t) / (alpha_tail / alpha_ini + (tau * (x - t) + t) / t - 1))
}
